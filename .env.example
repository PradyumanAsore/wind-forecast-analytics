# UK Wind Generation Forecast Analysis Platform
# Environment Configuration Example

# Backend settings
APP_NAME="UK Wind Generation Forecast Analysis Platform"
ENVIRONMENT="development"
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# Elexon BMRS API Configuration
# Official Insights Solution endpoint: https://data.elexon.co.uk/bmrs/api/v1
ELEXON_API_BASE_URL="https://data.elexon.co.uk/bmrs/api/v1"
ELEXON_REQUEST_TIMEOUT_SECONDS=30
ELEXON_MAX_RETRIES=3

# Day-Ahead Decision Logic
# UK Wholesale Day-Ahead power market auction gate closure (EPEX SPOT / Nord Pool auction) is at 11:00 London time (Europe/London) on D-1.
DEFAULT_DECISION_CUTOFF_TIME="11:00"
TIMEZONE="Europe/London"

# Interval Alignment Method:
# - 'hourly_block': Elexon WINDFOR forecasts are published at hourly resolution (:00) representing average forecast power for that hour.
#                   In UK settlement, each hour comprises two 30-minute settlement periods (e.g. 14:00-14:30 and 14:30-15:00).
#                   'hourly_block' maps the hourly forecast to both settlement periods.
# - 'exact_timestamp': Matches only intervals where startTime matches exactly (:00), flagging :30 as missing forecast.
ALIGNMENT_METHOD="hourly_block"

# Zero/Near-zero threshold for MAPE calculations (in MW) to prevent division by zero or extreme skew
MAPE_MIN_ACTUAL_MW=50.0

# Local Cache & Offline Fixture Fallback
ENABLE_LOCAL_CACHE=true
CACHE_DIR="data/cache"
FIXTURES_DIR="data/fixtures"

# Frontend settings (for Vite)
VITE_API_BASE_URL="http://localhost:8000"
